# Fish Audio API key: https://fish.audio/app/api-keys
FISH_API_KEY=

# Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional
CLAUDE_MODEL=claude-opus-5-5
# Jarvis's voice (any Fish Audio voice ID, including your own clone). Default: Adrian.
JARVIS_VOICE_ID=bf322df2096a46f18c579d0baa36f41d
# Second podcast host. Default: Delia.
COHOST_VOICE_ID=c70cfb98867a4bfb9ae20d2401257b92
# Real email through Resend (https://resend.com/api-keys). Without a key, emails stay in the demo outbox.
# RESEND_API_KEY=
# A sender on your verified Resend domain, e.g. Jarvis <jarvis@yourdomain.com>
# EMAIL_FROM=
# Testing: send every email here instead; the real recipient goes in the subject.
# EMAIL_REDIRECT_TO=
# Set to 1 to read websites without showing the browser window.
# JARVIS_HEADLESS=1
